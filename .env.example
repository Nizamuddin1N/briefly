# Copy this file to .env and fill in real values. Never commit .env.

# Groq API key — free tier at https://console.groq.com
GROQ_API_KEY=gsk_your_key_here

# Chat model to use. Groq retires models periodically — check what your key
# can access before assuming a model id still works.
GROQ_MODEL=openai/gpt-oss-120b

# JWT signing key. Generate a fresh one, never reuse an example value:
#   python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=replace_me_with_a_generated_64_char_hex_string

# Token lifetime in minutes (default: 24 hours)
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# PostgreSQL connection string
DATABASE_URL=postgresql://postgres:your_password@localhost:5432/research_agent

# Redis, used as both the Celery broker and result backend
REDIS_URL=redis://localhost:6379/0

# Comma-separated frontend origins allowed by CORS
CORS_ORIGINS=http://localhost:3000
